    FROM "dilemme_prisonnier"."main"."stg_parquets"
    UNION ALL
    SELECT
        Player_B AS personnalite, Run, Nb_tour, Resultat_P_B AS resultat
    FROM "dilemme_prisonnier"."main"."stg_parquets"
