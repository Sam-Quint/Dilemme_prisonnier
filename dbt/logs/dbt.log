    create  table
      "dilemme_prisonnier"."main"."mart_personnalite_global__dbt_tmp"
  
    as (
      

SELECT
    personnalite,
    SUM(nb_tournois)                                                               AS nb_tournois,
    SUM(total_rounds)                                                              AS total_rounds,
