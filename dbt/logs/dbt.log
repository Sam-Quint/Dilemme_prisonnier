    ROUND(SUM(taux_trahison_mutuelle * total_rounds) / SUM(total_rounds), 2)      AS avg_taux_trahison_mutuelle

FROM "dilemme_prisonnier"."main"."mart_matchup"
GROUP BY personnalite
ORDER BY avg_taux_libre DESC
    );
  
  
