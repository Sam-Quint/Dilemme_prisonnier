14:46:09.441173 [debug]: Query executed on node model.dilemme_prisonnier.mart_frequence_personnalite:
/* {"app": "dbt", "dbt_version": "2.0.0", "node_id": "model.dilemme_prisonnier.mart_frequence_personnalite", "profile_name": "dilemme_prisonnier", "target_name": "dev"} */

  
    
    

    create  table
      "dilemme_prisonnier"."main"."mart_frequence_personnalite__dbt_tmp"
  
    as (
      

WITH combined AS (
    SELECT Player_A AS personnalite, ID_Tournoi FROM "dilemme_prisonnier"."main"."stg_parquets"
    UNION ALL
    SELECT Player_B AS personnalite, ID_Tournoi FROM "dilemme_prisonnier"."main"."stg_parquets"
)
SELECT
    personnalite,
    COUNT(DISTINCT ID_Tournoi) AS nb_tournois,
    COUNT(*)                   AS total_rounds
FROM combined
GROUP BY personnalite
ORDER BY nb_tournois DESC, total_rounds DESC
    );
  
  
14:46:09.441458 [debug]: Query executed on node model.dilemme_prisonnier.mart_exploitation:
/* {"app": "dbt", "dbt_version": "2.0.0", "node_id": "model.dilemme_prisonnier.mart_exploitation", "profile_name": "dilemme_prisonnier", "target_name": "dev"} */

  
    
    

    create  table
      "dilemme_prisonnier"."main"."mart_exploitation__dbt_tmp"
  
    as (
      

WITH combined AS (
    SELECT Player_A AS personnalite, Player_B AS adversaire, Choix_P_A AS choix, Choix_P_B AS choix_adverse
    FROM "dilemme_prisonnier"."main"."stg_parquets"
    UNION ALL
    SELECT Player_B AS personnalite, Player_A AS adversaire, Choix_P_B AS choix, Choix_P_A AS choix_adverse
    FROM "dilemme_prisonnier"."main"."stg_parquets"
)
SELECT
    personnalite,
    adversaire,
    COUNT(*)                                                                                              AS total_rounds,
    COUNT(CASE WHEN choix = 'Trahir' AND choix_adverse = 'Coopéré' THEN 1 END)                           AS nb_exploitations,
    ROUND(COUNT(CASE WHEN choix = 'Trahir' AND choix_adverse = 'Coopéré' THEN 1 END) * 100.0 / COUNT(*), 2) AS taux_exploitation
FROM combined
GROUP BY personnalite, adversaire
ORDER BY taux_exploitation DESC
    );
  
  
14:46:09.443811 [debug]: Query executed on node model.dilemme_prisonnier.mart_classement_liberte:
/* {"app": "dbt", "dbt_version": "2.0.0", "node_id": "model.dilemme_prisonnier.mart_classement_liberte", "profile_name": "dilemme_prisonnier", "target_name": "dev"} */

  
    
    

    create  table
      "dilemme_prisonnier"."main"."mart_classement_liberte__dbt_tmp"
  
    as (
      

WITH combined AS (
    SELECT Player_A AS personnalite, Resultat_P_A AS resultat FROM "dilemme_prisonnier"."main"."stg_parquets"
    UNION ALL
    SELECT Player_B AS personnalite, Resultat_P_B AS resultat FROM "dilemme_prisonnier"."main"."stg_parquets"
)
SELECT
    ROW_NUMBER() OVER (ORDER BY COUNT(CASE WHEN resultat = 'Libre' THEN 1 END) * 1.0 / COUNT(*) DESC) AS classement,
    personnalite,
    COUNT(*)                                                                                            AS total_rounds,
    COUNT(CASE WHEN resultat = 'Libre' THEN 1 END)                                                     AS nb_libres,
    ROUND(COUNT(CASE WHEN resultat = 'Libre' THEN 1 END) * 100.0 / COUNT(*), 2)                        AS taux_libre
FROM combined
GROUP BY personnalite
ORDER BY classement
    );
  
  
